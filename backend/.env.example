# FastAPI Backend Configuration
PROJECT_NAME="Job Matching System (mBERT)"
SECRET_KEY="YOUR_SUPER_SECRET_RANDOM_KEY_CHANGE_THIS"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_matching_db"

# Model & Thresholds
MODEL_NAME="bert-base-multilingual-cased"
MAX_SEQ_LENGTH=512
CHUNK_STRIDE=256
THRESHOLD_FIT=0.80
THRESHOLD_CLOSE_FIT=0.60
